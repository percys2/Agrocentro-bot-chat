# Copiá este archivo a .env y completalo. En Railway/Render se ponen como variables del servicio.

# --- Claude (console.anthropic.com → API keys) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modelo: claude-sonnet-5 (recomendado) o claude-haiku-4-5-20251001 (más barato)
ANTHROPIC_MODEL=claude-sonnet-5

# --- WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp → API Setup) ---
# Token de acceso (el temporal dura 24 h; para producción creá un token permanente de usuario del sistema)
WHATSAPP_TOKEN=EAAG...
# "Phone number ID" del número de prueba (no es el número de teléfono)
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Palabra que vos inventás; la misma se escribe en la configuración del webhook en Meta
WHATSAPP_VERIFY_TOKEN=agrocentro-verifica-2026
# App secret (Configuración de la app → Básica) para validar la firma de los webhooks
WHATSAPP_APP_SECRET=
# Versión de la Graph API
WHATSAPP_API_VERSION=v22.0

# --- Dueño / asesor ---
# Tu número en formato internacional sin "+": recibe los pedidos nuevos y puede mandar comandos (confirmar, listo, rechazar...)
OWNER_PHONE=50588887777
# Opcional: nombre de una plantilla aprobada con un parámetro {{1}} para avisarte fuera de la ventana de 24 h
OWNER_ALERT_TEMPLATE=
OWNER_ALERT_TEMPLATE_LANG=es

# --- Servidor ---
PORT=3000
# Carpeta donde se guardan sesiones y pedidos (en Railway: montá un volumen y apuntá aquí, ej. /data)
RUNTIME_DIR=./data/runtime
# snapshot = usa data/*.json · site = usa las copias crudas de data/site/*.js (después de `npm run sync-site`)
DATA_SOURCE=snapshot
LOG_LEVEL=info
